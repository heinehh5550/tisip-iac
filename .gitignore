# =============================================================================
#  .gitignore  –  NETTVERKSPROSJEKTET
# -----------------------------------------------------------------------------
#  Etter øving 6 ligger staten i Azure, ikke på disken. Betyr det at
#  *.tfstate kan fjernes herfra?
#
#  Nei. To grunner:
#
#   1. En kollega – eller du selv, om tre uker – kan kjøre terraform init UTEN
#      -backend-config og få lokal state uten å merke det. Da ligger fila der
#      igjen, og .gitignore er det eneste som stopper den.
#
#   2. terraform init -migrate-state legger igjen en terraform.tfstate.backup
#      med HELE den gamle staten i klartekst.
#
#  Linja koster ingenting og fanger et uhell som ikke kan gjøres om: er en
#  state først pushet, må alt som lå i den regnes som kompromittert.
# =============================================================================
 
*.tfstate
*.tfstate.*
*.tfstate.backup
 
.terraform/
 
# MERK: backend.hcl er IKKE ignorert.
#
# Den inneholder navn på en ressursgruppe, en storage-konto og en container –
# ikke hemmeligheter. Navn er ikke tilgang: uten en Entra-identitet med
# Storage Blob Data Contributor kommer man ingen vei med dem. Det er nettopp
# derfor use_azuread_auth = true står der, og ingen kontonøkkel.
#
# Filen er dessuten lik for alle miljøer, og hører hjemme i repoet slik at
# init-kommandoen i modul 7 kan peke på den.
 
# Miljøfilene inneholder bare kortnavn, prosjektnavn og region – ingen
# hemmeligheter. De sjekkes inn med vilje, slik at pipelinen i modul 7 kan
# bruke dem.
#   dev.tfvars      ← sjekkes inn
#   prod.tfvars     ← sjekkes inn
 
*.tfplan
crash.log